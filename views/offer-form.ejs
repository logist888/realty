<%- include('partials/header', { title: offer ? 'Редактирование объявления' : 'Новое объявление' }) %>

<div class="container narrow">
  <h1><%= offer ? 'Редактирование объявления' : 'Разместить объявление' %></h1>

  <% if (errors.length) { %>
    <div class="alert alert-error">
      <ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>

  <ol class="wizard-progress" id="wizard-progress">
    <li class="wstep" data-step="0"><span class="wstep-num">1</span><span class="wstep-label">Тип</span></li>
    <li class="wstep" data-step="1"><span class="wstep-num">2</span><span class="wstep-label">Адрес</span></li>
    <li class="wstep" data-step="2"><span class="wstep-num">3</span><span class="wstep-label">Параметры</span></li>
    <li class="wstep" data-step="3"><span class="wstep-num">4</span><span class="wstep-label">Цена и описание</span></li>
    <li class="wstep" data-step="4"><span class="wstep-num">5</span><span class="wstep-label">Фото</span></li>
  </ol>

  <form method="post" enctype="multipart/form-data" class="offer-form" id="offer-form">

    <!-- Шаг 1: тип сделки и недвижимости -->
    <section class="wizard-step" data-step="0">
      <h2 class="wizard-title">Что размещаете?</h2>
      <div class="choice-label">Тип сделки</div>
      <div class="choice-group">
        <% [['sale', 'Продажа'], ['rent_long', 'Долгосрочная аренда'], ['rent_daily', 'Посуточная аренда']].forEach(([val, label]) => { %>
          <label class="choice-card">
            <input type="radio" name="deal_type" value="<%= val %>" <%= (values.deal_type || 'sale') === val ? 'checked' : '' %>>
            <span><%= label %></span>
          </label>
        <% }) %>
      </div>
      <div class="choice-label">Тип недвижимости</div>
      <div class="choice-group">
        <% const typeIcons = { flat: '🏢', room: '🚪', house: '🏡', commercial: '🏬', storage: '📦', parking: '🚗' }; %>
        <% Object.entries(h.OFFER_TYPES).forEach(([val, label]) => { %>
          <label class="choice-card">
            <input type="radio" name="offer_type" value="<%= val %>" <%= (values.offer_type || 'flat') === val ? 'checked' : '' %>>
            <span><%= typeIcons[val] %> <%= label %></span>
          </label>
        <% }) %>
      </div>
    </section>

    <!-- Шаг 2: адрес -->
    <section class="wizard-step" data-step="1" hidden>
      <h2 class="wizard-title">Где находится объект?</h2>
      <div class="form-row">
        <label>Город *
          <input list="cities" name="city" id="city-input" class="input" required value="<%= values.city || '' %>" placeholder="Любой город России">
          <datalist id="cities">
            <% h.RU_CITIES.forEach(c => { %><option value="<%= c %>"><% }) %>
          </datalist>
        </label>
        <label data-types="flat,room,house">Район <span class="muted">(подставится из подсказки адреса)</span>
          <input name="district" id="district-input" class="input" value="<%= values.district || '' %>" placeholder="ЦАО">
        </label>
      </div>
      <label class="suggest-wrap">Улица, дом *
        <input name="address" id="address-input" class="input" required autocomplete="off"
               value="<%= values.address || '' %>" placeholder="Начните вводить: ул. Ленина, 10">
        <div class="suggest-list" id="address-suggest" hidden></div>
        <span class="muted">Выберите адрес из подсказок — тогда объект появится на карте в точном месте</span>
      </label>
      <input type="hidden" name="lat" id="lat-input" value="<%= values.lat || '' %>">
      <input type="hidden" name="lng" id="lng-input" value="<%= values.lng || '' %>">
      <div class="geo-status muted" id="geo-status" <%= values.lat ? '' : 'hidden' %>>
        📍 Координаты определены: <span id="geo-coords"><%= values.lat ? Number(values.lat).toFixed(5) + ', ' + Number(values.lng).toFixed(5) : '' %></span>
      </div>
      <div class="form-row">
        <label>Метро
          <input name="metro" class="input" value="<%= values.metro || '' %>" placeholder="Арбатская">
        </label>
        <label>Минут до метро
          <input type="number" name="metro_minutes" class="input" min="1" max="120" value="<%= values.metro_minutes || '' %>">
        </label>
      </div>
    </section>

    <!-- Шаг 3: параметры -->
    <section class="wizard-step" data-step="2" hidden>
      <h2 class="wizard-title">Параметры объекта</h2>

      <div class="form-row" data-types="flat,room,house">
        <label>Комнат (0 — студия)
          <input type="number" name="rooms" class="input" min="0" max="20" value="<%= values.rooms != null ? values.rooms : 1 %>">
        </label>
        <label>Жилая площадь, м²
          <input type="number" name="area_living" class="input" min="1" step="0.1" value="<%= values.area_living || '' %>">
        </label>
      </div>

      <div class="form-row">
        <label>Общая площадь, м² *
          <input type="number" name="area_total" class="input" required min="0.5" step="0.1" value="<%= values.area_total || '' %>">
        </label>
        <label data-types="flat,room">Кухня, м²
          <input type="number" name="area_kitchen" class="input" min="1" step="0.1" value="<%= values.area_kitchen || '' %>">
        </label>
      </div>

      <div class="form-row" data-types="commercial">
        <label>Назначение помещения
          <select name="purpose" class="input">
            <option value="">Не указано</option>
            <% h.PURPOSES.forEach(p => { %>
              <option value="<%= p %>" <%= values.purpose === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </label>
        <label class="checkbox-label checkbox-inline">
          <input type="checkbox" name="separate_entrance" value="1" <%= values.separate_entrance ? 'checked' : '' %>> Отдельный вход
        </label>
      </div>

      <div class="form-row" data-types="parking">
        <label>Тип паркинга
          <select name="parking_type" class="input">
            <option value="">Не указан</option>
            <% h.PARKING_TYPES.forEach(p => { %>
              <option value="<%= p %>" <%= values.parking_type === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <div class="form-row" data-types="flat,room,commercial,storage,parking">
        <label>Этаж <span class="muted">(−1…−10 — подземные, 0 — цоколь)</span>
          <input type="number" name="floor" class="input" min="-10" max="100" value="<%= values.floor != null ? values.floor : '' %>">
        </label>
        <label>Этажей в доме
          <input type="number" name="floors_total" class="input" min="1" max="100" value="<%= values.floors_total || '' %>">
        </label>
      </div>

      <div class="form-row" data-types="commercial,storage,parking">
        <label>Высота потолков, м
          <input type="number" name="ceiling_height" class="input" min="1" max="20" step="0.1" value="<%= values.ceiling_height || '' %>">
        </label>
        <label class="checkbox-label checkbox-inline">
          <input type="checkbox" name="security" value="1" <%= values.security ? 'checked' : '' %>> Охрана / видеонаблюдение
        </label>
      </div>

      <div class="form-row">
        <label data-types="flat,room,house,commercial">Год постройки
          <input type="number" name="build_year" class="input" min="1850" max="2030" value="<%= values.build_year || '' %>">
        </label>
        <label data-types="flat,room,house,commercial">Ремонт
          <select name="renovation" class="input">
            <option value="">Не указан</option>
            <% h.RENOVATIONS.forEach(r => { %>
              <option value="<%= r %>" <%= values.renovation === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <label class="checkbox-label" data-types="flat,room">
        <input type="checkbox" name="balcony" value="1" <%= values.balcony ? 'checked' : '' %>> Балкон или лоджия
      </label>
    </section>

    <!-- Шаг 4: цена и описание -->
    <section class="wizard-step" data-step="3" hidden>
      <h2 class="wizard-title">Цена и описание</h2>
      <label>Цена, ₽ * <span class="muted">(для аренды — в месяц или сутки)</span>
        <input type="number" name="price" class="input" required min="1" value="<%= values.price || '' %>">
      </label>
      <label>Описание
        <textarea name="description" class="input" rows="6" placeholder="Расскажите об объекте: состояние, инфраструктура, условия сделки..."><%= values.description || '' %></textarea>
      </label>
    </section>

    <!-- Шаг 5: фотографии -->
    <section class="wizard-step" data-step="4" hidden>
      <h2 class="wizard-title">Фотографии</h2>
      <div class="dropzone" id="dropzone" tabindex="0" role="button"
           aria-label="Загрузить фотографии">
        <input type="file" name="photos" id="photos-input" accept="image/*" multiple hidden>
        <div class="dropzone-hint">
          <div class="dropzone-icon">🖼️</div>
          <strong>Перетащите фото сюда</strong> или нажмите, чтобы выбрать<br>
          <span class="muted">Можно сразу несколько. До 10 фото, JPG/PNG/WebP, до 8 МБ каждое.</span>
        </div>
      </div>
      <div class="photo-previews" id="photo-previews"></div>
      <p class="muted">
        <% if (!offer) { %>Если не добавить фото, будут использованы заглушки.<% } else { %>Новые фото добавятся к существующим.<% } %>
      </p>
    </section>

    <div class="wizard-nav">
      <button type="button" class="btn btn-outline" id="wizard-back" hidden>← Назад</button>
      <div class="wizard-nav-spacer"></div>
      <button type="button" class="btn btn-primary" id="wizard-next">Далее →</button>
      <button type="submit" class="btn btn-accent btn-lg" id="wizard-submit" hidden>
        <%= offer ? 'Сохранить изменения' : 'Опубликовать объявление' %>
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
